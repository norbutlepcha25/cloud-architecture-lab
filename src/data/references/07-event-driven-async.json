        "label": "Application Load Balancer",
        "category": "Load Balancing",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "public",
        "replicas": 2,
        "multiAz": true
      }
    },
    {
      "id": "node-web-ecs",
      "type": "serviceNode",
      "position": {
        "x": 380,
        "y": 220
      },
      "data": {
        "serviceId": "ecs",
        "label": "Web API (ECS)",
        "category": "Containers",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "private",
        "replicas": 3,
        "multiAz": true,
        "iamRole": {
          "id": "WebApiTaskRole",
          "trustPolicy": {
            "id": "WebApiTaskRole-trust",
            "kind": "trust",
            "statements": [
              {
                "effect": "Allow",
                "actions": [
                  "sts:AssumeRole"
                ],
                "resources": [],
                "principals": [
                  "ecs-tasks.amazonaws.com"
                ]
              }
            ]
          },
          "identityPolicies": [
            {
              "id": "WebApiTaskRole-permissions",
              "kind": "identity",
              "statements": [
                {
                  "effect": "Allow",
                  "actions": [
                    "sqs:SendMessage"
                  ],
                  "resources": [
                    "arn:aws:sqs:::node-sqs"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "node-sqs",
      "type": "serviceNode",
      "position": {
        "x": 560,
        "y": 220
      },
      "data": {
        "serviceId": "sqs",
        "label": "Amazon SQS",
        "category": "Messaging",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "private",
        "replicas": 1,
        "multiAz": true,
        "notes": "Buffers requests",
        "customConfig": {
          "redrivePolicy": {
            "deadLetterTargetId": "node-sqs-dlq",
            "maxReceiveCount": 5
          },
          "visibilityTimeoutSeconds": 60
        }
      }
    },
    {
      "id": "node-worker-ecs",
      "type": "serviceNode",
      "position": {
        "x": 740,
        "y": 220
      },
      "data": {
        "serviceId": "ecs",
        "label": "Worker Service",
        "category": "Containers",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "private",
        "replicas": 2,
        "multiAz": true,
        "iamRole": {
          "id": "WorkerTaskRole",
          "trustPolicy": {
            "id": "WorkerTaskRole-trust",
            "kind": "trust",
            "statements": [
              {
                "effect": "Allow",
                "actions": [
                  "sts:AssumeRole"
                ],
                "resources": [],
                "principals": [
                  "ecs-tasks.amazonaws.com"
                ]
              }
            ]
          },
          "identityPolicies": [
            {
              "id": "WorkerTaskRole-permissions",
              "kind": "identity",
              "statements": [
                {
                  "effect": "Allow",
                  "actions": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "resources": [
                    "arn:aws:sqs:::node-sqs"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
