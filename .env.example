# Optional Umami analytics. Tracking remains off until all three values are set.
# Public website ID, not an API key. Copy script URL and ID from your Umami dashboard.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Exact production hostnames, without protocol or paths; comma separated.
VITE_UMAMI_DOMAINS=
