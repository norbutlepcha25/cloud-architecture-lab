    {
      "id": "node-sqs-endpoint",
      "type": "serviceNode",
      "position": {
        "x": 560,
        "y": 90
      },
      "data": {
        "serviceId": "privatelink",
        "label": "SQS interface endpoint",
        "category": "Networking & Content Delivery",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "private",
        "replicas": 1,
        "multiAz": false,
        "customConfig": {
          "endpointService": "sqs"
        },
        "notes": "Private DNS resolves the SQS endpoint inside the VPC; no NAT gateway needed."
      }
    },
    {
      "id": "node-sqs-dlq",
      "type": "serviceNode",
      "position": {
        "x": 560,
        "y": 380
      },
      "data": {
        "serviceId": "sqs_dlq",
        "label": "Orders DLQ",
        "category": "Integration & Messaging",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "global",
        "replicas": 1,
        "multiAz": false,
        "customConfig": {
          "messageRetentionSeconds": 1209600
        },
        "notes": "Receives messages the worker fails to process 5 times; retention longer than the source queue."
      }
    }
  ],
  "edges": [
    {
      "id": "e-u-igw",
      "source": "node-user",
      "target": "node-igw",
      "type": "custom",
      "data": {
        "protocol": "HTTPS",
        "stepNumber": 1,
        "interactionType": "synchronous",
        "isCriticalDependency": true,
        "timeoutMs": 1000
      }
    },
    {
