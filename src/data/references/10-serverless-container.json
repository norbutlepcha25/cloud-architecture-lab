      "type": "serviceNode",
      "position": {
        "x": 620,
        "y": 380
      },
      "data": {
        "serviceId": "auto_scaling_mgmt",
        "label": "Service Auto Scaling (foods)",
        "category": "Management & Governance",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "private",
        "replicas": 1,
        "multiAz": true
      }
    },
    {
      "id": "node-dynamodb-foods",
      "type": "serviceNode",
      "position": {
        "x": 820,
        "y": 400
      },
      "data": {
        "serviceId": "dynamodb",
        "label": "DynamoDB Table (foods)",
        "category": "Databases",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "global",
        "replicas": 1,
        "multiAz": true
      }
    },
    {
      "id": "node-dynamodb-endpoint",
      "type": "serviceNode",
      "position": {
        "x": 700,
        "y": 250
      },
      "data": {
        "serviceId": "s3_gateway_endpoint",
        "label": "DynamoDB gateway endpoint",
        "category": "Networking & Content Delivery",
        "health": "healthy",
        "az": "Multi-AZ",
        "subnet": "global",
        "replicas": 1,
        "multiAz": false,
        "customConfig": {
          "endpointService": "dynamodb"
        },
        "notes": "Private route from the ECS tasks to DynamoDB without a NAT gateway."
      }
    }
  ],
  "edges": [
